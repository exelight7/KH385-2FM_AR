[
  {
    "index": 0,
    "id": "02000000",
    "english": "The destiny that is about to unfold",
    "arabic": "إن المصير الذي يوشك أن يتكشف"
  },
  {
    "index": 1,
    "id": "02000100",
    "english": "actually started when we first met",
    "arabic": "بدأ حين التقينا أول مرة"
  },
  {
    "index": 2,
    "id": "02000200",
    "english": "on the seventh day after I came here.",
    "arabic": "في اليوم السابع بعد وصولي إلى هنا."
  },
  {
    "index": 4,
    "id": "02018000",
    "english": "For the seven days since my arrival--",
    "arabic": "طوال الأيام السبعة منذ وصولي..."
  },
  {
    "index": 5,
    "id": "02018100",
    "english": "the name Roxas, and the number\nthirteen were all I had.",
    "arabic": "لم يكن لدي سوى اسم روكساس\nوالرقم ثلاثة عشر."
  },
  {
    "index": 6,
    "id": "02018200",
    "english": "Who the people around me were, what they\nwanted, or what they were trying to do,",
    "arabic": "لم أعرف من حولي ولا ما يريدون,\nولا ما كانوا يحاولون فعله,"
  },
  {
    "index": 7,
    "id": "02018300",
    "english": "I had no idea...",
    "arabic": "لم أكن أعرف شيئا..."
  },
  {
    "index": 9,
    "id": "02020000",
    "english": "Teach him well, Axel.",
    "arabic": "أحسن تعليمه يا آكسل."
  },
  {
    "index": 10,
    "id": "02020100",
    "english": "Don't worry.\nI'll be sure he makes the grade.",
    "arabic": "لا تقلق.\nسأجعله جديرا بنا."
  },
  {
    "index": 11,
    "id": "02020200",
    "english": "Roxas, let's go.",
    "arabic": "هيا بنا يا روكساس."
  },
  {
    "index": 12,
    "id": "02020300",
    "english": "What's wrong?",
    "arabic": "ما الأمر?"
  },
  {
    "index": 13,
    "id": "02021000",
    "english": "You worried about the new kid?",
    "arabic": "أتقلق على الفتى الجديد?"
  },
  {
    "index": 14,
    "id": "02020400",
    "english": "What was that name again...",
    "arabic": "ما اسمه مجددا..."
  },
  {
    "index": 15,
    "id": "02020500",
    "english": "Number XIV, Xion.",
    "arabic": "رقم 14, شيون."
  },
  {
    "index": 16,
    "id": "02020600",
    "english": "Right. I knew that.",
    "arabic": "صحيح, كنت أعرف ذلك."
  },
  {
    "index": 17,
    "id": "02020700",
    "english": "Xion...",
    "arabic": "شيون..."
  },
  {
    "index": 18,
    "id": "02020800",
    "english": "Got it memorized, Roxas?",
    "arabic": "حفظتها يا روكساس?"
  },
  {
    "index": 19,
    "id": "02020900",
    "english": "Yeah...",
    "arabic": "أجل..."
  },
  {
    "index": 20,
    "id": "02020a00",
    "english": "Yeah? How 'bout my name, then?",
    "arabic": "أجل? وماذا عن اسمي?"
  },
  {
    "index": 21,
    "id": "02020b00",
    "english": "Axel...",
    "arabic": "آكسل..."
  },
  {
    "index": 22,
    "id": "02020c00",
    "english": "And how about our boss's name, huh?",
    "arabic": "وماذا عن اسم زعيمنا?"
  },
  {
    "index": 23,
    "id": "02020f00",
    "english": "Xemnas...",
    "arabic": "زيمناس..."
  },
  {
    "index": 24,
    "id": "02020d00",
    "english": "No way you're gonna forget his name, right?",
    "arabic": "لن تنسى اسمه, أليس كذلك?"
  },
  {
    "index": 25,
    "id": "02020e00",
    "english": "Let's go.",
    "arabic": "هيا بنا."
  }
]
