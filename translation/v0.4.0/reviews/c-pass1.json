  "corrections": [
    {
      "file": "cthd100",
      "id": "02358400",
      "before": "هو ما يجعلك أنت وشيون\nجزءا من حياة بعضكما.",
      "after": "هو ما يجعل كلا منكما\nجزءا من حياة الآخر.",
      "reason": "إصلاح تركيب «حياة بعضكما» مع إبقاء معنى دخول كل منهما في حياة الآخر.",
      "category": "grammar"
    },
    {
      "file": "cthd100",
      "id": "02358601",
      "before": "فعليك أن تصرف ذهنك\nعن هذه المشاغل التي لا داعي لها.",
      "after": "فعليك أن تصرف ذهنك\nعن هذه الأمور التي تشغلك بلا داع.",
      "reason": "صياغة طبيعية للملهيات غير الضرورية؛ «المشاغل» قد توحي بالواجبات بدلا من التشتيت.",
      "category": "wording"
    },
    {
      "file": "cthd100",
      "id": "023a0200",
      "before": "حسنا، أنا...",
      "after": "حسنا، أمم...",
      "reason": "الأصل تردد Well, um ولا يتضمن بدء جملة بضمير «أنا».",
      "category": "fidelity"
    },
    {
      "file": "cthd100",
      "id": "023a1000",
      "before": "فربما تسلبين روكساس\nمن قواه أكثر مما ينبغي لك.",
      "after": "فربما تسلبين من روكساس\nقوة أكثر مما ينبغي.",
      "reason": "إصلاح تعدية «تسلبين روكساس من قواه» مع الحفاظ على أن قوتها تنمو على حساب قوته.",
      "category": "grammar"
    },
    {
      "file": "cthd100",
      "id": "023d9100",
      "before": "أعرف أننا رأينا غروب الشمس كثيرا،\nلكن غروب اليوم يفوقها جميعا جمالا.",
      "after": "أعرف أننا شاهدنا الغروب مرارا،\nلكن غروب اليوم يفوق كل ما رأيناه جمالا.",
      "reason": "إصلاح مرجع ضمير الجمع «يفوقها» بعد «غروب الشمس» المفرد مع حفظ المقارنة بكل الغروبات السابقة.",
      "category": "agreement"
    },
    {
      "file": "cthd100",
      "id": "023f0300",
      "before": "لماذا أواجه دائما\nتلك النظرة الغاضبة منك؟",
      "after": "لماذا تحدق بي دائما\nبتلك النظرة الغاضبة؟",
      "reason": "استعادة إسناد التحديق المباشر إلى المخاطب بدلا من الصياغة الحرفية غير الطبيعية «أواجه تلك النظرة منك».",
      "category": "wording"
    },
    {
      "file": "cthd100",
      "id": "023f8300",
      "before": "سأقر له بذلك.\nلا أستطيع إلقاء اللوم على غيري.",
      "after": "أقر له بذلك.\nلا أستطيع إلقاء اللوم على غيري.",
      "reason": "I will give him that هنا إقرار آني بصحة قوله، لا وعد بفعل مستقبلي.",
      "category": "idiom"
    },
    {
      "file": "cthd100",
      "id": "02408700",
      "before": "ربما تود أن تشرح لنا\nمشروعك المفضل هذا.",
      "after": "ربما تود أن تطلعنا\nعلى مشروعك العزيز عليك.",
      "reason": "Pet project مشروع يعتز به صاحبه، وليس بالضرورة مشروعه المفضل مقارنة بكل مشاريعه.",
      "category": "idiom"
    },
    {
      "file": "cthd100",
      "id": "02418a00",
      "before": "وأعرف الآن أن السبب ليس\nضعفها بعد خسارة أعضائها.",
      "after": "وأعرف الآن أن السبب ليس\nضعفها بسبب تناقص عدد أعضائها.",
      "reason": "حفظ معنى انخفاض عدد الأعضاء وتسببه المفترض بالضعف، دون إيحاء بخسارة جميع الأعضاء.",
      "category": "fidelity"
    },
    {
      "file": "cthd100",
      "id": "02419500",
      "before": "سأتولى ذلك يا جلا...",
      "after": "تكفلت بذلك يا جلا...",
      "reason": "Got that covered تعني أنه تولى الأمر ورتب له بالفعل، لا أنه سيبدأ توليه لاحقا.",
      "category": "tense"
    },
    {
      "file": "cthd100",
      "id": "02421200",
      "before": "يفترض بأعز الأصدقاء\nأن يكونوا صادقين مع بعضهم!",
      "after": "يفترض بأعز الأصدقاء\nأن يكونوا صادقين بعضهم مع بعض!",
      "reason": "صياغة فصيحة سليمة للعلاقة المتبادلة، مع حفظ مصطلح أعز الأصدقاء.",
      "category": "grammar"
    },
    {
      "file": "cthd100",
      "id": "02429301",
      "before": "لا أستطيع أن أبقي حتى جزءا واحدا\nمن الذكرى التي تمثلك مرتبطا.",
      "after": "لا أستطيع أن أبقي ولو جزءا واحدا\nمن الذكرى المسماة «أنت» متصلا.",
      "reason": "الحفاظ على تسمية الذكرى «أنت» الواردة صراحة في الأصل، وعلى معنى بقاء أجزائها متصلة.",
      "category": "fidelity"
    },
    {
      "file": "cthd300",
      "id": "02a10000",
      "before": "[BGTRANS:tz171a.tm2]قبل عودته إلى القلعة،\nرأى روكساس الوحش مصابا\nبعدما حمى ما يهمه،\nورأى بيل تعتني به.\n\nكان الحب قد نما بينهما. أعلن\nزالدين أن قوة الحب عديمة القيمة.\nسأله روكساس عن تلك القوة، لكن\nزالدين قال إن شرح الفكرة\nلأحد اللا أحد ممن لا قلب\nلهم لا جدوى منه، ثم رحل.",
      "after": "[BGTRANS:tz171a.tm2]قبل عودته إلى القلعة،\nرأى روكساس الوحش مصابا\nبعدما حمى ما يهمه،\nورأى بيل تعتني به.\n\nكان الحب قد نما بينهما. أعلن\nزالدين أن قوة الحب عديمة القيمة.\nسأله روكساس عن تلك القوة، لكن\nزالدين قال إن شرح الفكرة\nلواحد من اللا أحد لا يملك\nقلبا لن يجدي، ثم رحل.",
      "reason": "إصلاح التركيب المتعثر «لأحد اللا أحد ممن لا قلب لهم» مع إبقاء المصطلح الثابت ومعنى انتفاء جدوى الشرح لمن لا قلب له.",
      "category": "grammar"
    },
    {
      "file": "cthd300",
